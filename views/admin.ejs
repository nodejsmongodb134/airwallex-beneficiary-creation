<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
</head>

<body class="bg-light">

<div class="container-fluid py-4 px-4" style="max-width: 1800px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Administrator Dashboard</h2>

    <div>
      👋 Welcome,
      <strong><%= user.username %></strong>

      <a href="/logout" class="btn btn-danger btn-sm ms-3">
        Logout
      </a>
    </div>
  </div>

  <!-- STATS -->
  <div class="row mb-4">

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Total Users</h6>
          <h2><%= totalUsers %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Total Beneficiaries</h6>
          <h2><%= totalBeneficiaries %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Total Transfers</h6>
          <h2><%= totalTransfers %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card shadow-sm">
        <div class="card-body">
          <h6>Pending</h6>
          <h2><%= pendingTransfers %></h2>
        </div>
      </div>
    </div>

  </div>

  <!-- STATUS -->
  <div class="row mb-4">

    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5>Transfer Status</h5>

          <p class="text-warning">
            Pending:
            <strong><%= pendingTransfers %></strong>
          </p>

          <p class="text-success">
            Success:
            <strong><%= successTransfers %></strong>
          </p>

          <p class="text-danger">
            Failed:
            <strong><%= failedTransfers %></strong>
          </p>
        </div>
      </div>
    </div>

  </div>

<!--------- TABS Navigation-------------------->

<!-- TABS -->
<ul class="nav nav-tabs mb-3">

  <li class="nav-item">
    <button
      class="nav-link active"
      data-bs-toggle="tab"
      data-bs-target="#users"
    >
      Recent Users
    </button>
  </li>

  <li class="nav-item">
    <button
      class="nav-link"
      data-bs-toggle="tab"
      data-bs-target="#beneficiaries"
    >
      Recent Beneficiaries
    </button>
  </li>

  <li class="nav-item">
    <button
      class="nav-link"
      data-bs-toggle="tab"
      data-bs-target="#transfers"
    >
      Recent Transfers
    </button>
  </li>

</ul>

<!-- TAB CONTENT -->
<div class="tab-content">

  <!-- USERS -->
  <div class="tab-pane fade show active" id="users">

    <%- include("partials/recentUsers") %>

  </div>

  <!-- BENEFICIARIES -->
  <div class="tab-pane fade" id="beneficiaries">

    <%- include("partials/recentBeneficiaries") %>

  </div>

  <!-- TRANSFERS -->
  <div class="tab-pane fade" id="transfers">

    <%- include("partials/recentTransfers") %>

  </div>

</div>

<!-- BOOTSTRAP JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-------------END TAB--------------------------->

  

</div>

</body>
</html>